file(DOWNLOAD https://people.maths.bris.ac.uk/~maarb/code/factor64_data.xz factor64_data.xz)
if(win32)
    execute_process(COMMAND 7z x factor64_data.xz)
    execute_process(COMMAND ./makefactortable.exe)
else()
    execute_process(COMMAND unxz factor64_data.xz)
    execute_process(COMMAND ./makefactortable)
endif()
file(CHMOD factor64_data PERMISSIONS WORLD_READ GROUP_READ OWNER_READ)
file(RENAME factor64_data factor.bin)
